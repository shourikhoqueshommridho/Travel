# MongoDB connection string (get yours from MongoDB Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Optional: database name. If empty, uses the database in the URI path, or the driver default.
MONGODB_DB=

# Optional: override the API port (defaults to 8000)
PORT=8000

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:3000
